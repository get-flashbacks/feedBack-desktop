{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://get-flashbacks.github.io/feedBack-desktop/plugin-catalog.schema.json",
  "title": "feedBack Desktop plugin catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "installDir",
        "name",
        "description",
        "repository",
        "commit",
        "archiveSha256",
        "source",
        "category",
        "instruments",
        "stability",
        "compatibility",
        "dependencies",
        "conflicts",
        "size",
        "selection"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "installDir": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^https://github\\.com/[^/]+/[^/]+$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "archiveSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source": {
          "enum": [
            "get-flashbacks",
            "upstream-official",
            "reviewed-community"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "instruments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "stability": {
          "enum": [
            "stable",
            "beta",
            "experimental"
          ]
        },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minCoreVersion",
            "minPluginApiVersion"
          ],
          "properties": {
            "minCoreVersion": {
              "type": "string",
              "minLength": 1
            },
            "maxCoreVersion": {
              "type": "string",
              "minLength": 1
            },
            "minPluginApiVersion": {
              "type": "string",
              "minLength": 1
            },
            "maxPluginApiVersion": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "size": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "downloadBytes",
            "installedBytes"
          ],
          "properties": {
            "downloadBytes": {
              "type": "integer",
              "minimum": 0
            },
            "installedBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tier",
            "defaultSelected"
          ],
          "properties": {
            "tier": {
              "enum": [
                "essential",
                "recommended",
                "optional",
                "hidden"
              ]
            },
            "defaultSelected": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
